# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé service role (Dashboard Supabase → Settings → API). SERVEUR UNIQUEMENT.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Google Places API ────────────────────────────────────────────────────────
# Sans cette clé, l'app tourne en mode démo (données fictives).
GOOGLE_PLACES_API_KEY=AIza...

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_...
# Coupon Stripe appliqué le 1er mois du plan Starter (optionnel)
STRIPE_STARTER_FIRST_MONTH_COUPON=

# ── Divers ───────────────────────────────────────────────────────────────────
# URL publique du site (utilisée pour les redirections Stripe)
NEXT_PUBLIC_SITE_URL=https://leadvibe.fr
# Secret du cron Vercel de reset des quotas (générer une chaîne aléatoire)
CRON_SECRET=

# ── INSEE SIRENE (optionnel — enrichissement SIREN/SIRET) ────────────────────
# Créer un compte sur https://portail-api.insee.fr/
INSEE_API_TOKEN=
